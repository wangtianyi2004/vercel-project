<!DOCTYPE html>
<html lang="zh-CN" data-lang="zh">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Claude Code 监控平台 · Langfuse + Grafana on ClickHouse</title>
<meta name="description" content="基于 Langfuse + Grafana 的 Claude Code 可观测性方案：OKR 设计框架 / 真实数据 / 部署 SOP / 方案对比">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Noto+Sans+SC:wght@400;500;700;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
/* ============================== Reset & Base ============================== */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; scroll-padding-top: 140px; }
body {
  background: var(--bg); color: var(--text);
  font-family: var(--font-sans); font-size: 15px; line-height: 1.6;
  font-feature-settings: 'cv11', 'ss01';
  -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
  min-height: 100vh; overflow-x: hidden;
}
::selection { background: var(--yellow); color: #000; }

/* ============================== Tokens ============================== */
:root {
  --bg: #0a0a0a;
  --bg-1: #151515;
  --bg-2: #1d1d1d;
  --bg-3: #262626;
  --line: #2a2a2a;
  --line-soft: #1c1c1c;
  --line-strong: #3a3a3a;
  --text: #f5f4ef;
  --text-2: #c7c5bd;
  --text-3: #8a887f;
  --text-4: #555349;

  --yellow: #FCFF74;
  --yellow-pure: #FCFF74;
  --yellow-soft: rgba(252, 255, 116, 0.08);
  --yellow-line: rgba(252, 255, 116, 0.32);
  --yellow-dim: #C8CC4B;

  --o1: #5EA8FF;  --o1-soft: rgba(94, 168, 255, 0.10);  --o1-line: rgba(94, 168, 255, 0.32);
  --o2: #4ADE80;  --o2-soft: rgba(74, 222, 128, 0.10);  --o2-line: rgba(74, 222, 128, 0.32);
  --o3: #FB923C;  --o3-soft: rgba(251, 146, 60, 0.10);  --o3-line: rgba(251, 146, 60, 0.32);
  --o4: #C084FC;  --o4-soft: rgba(192, 132, 252, 0.10); --o4-line: rgba(192, 132, 252, 0.32);

  --ok: #4ADE80;    --ok-soft: rgba(74, 222, 128, 0.12);   --ok-line: rgba(74, 222, 128, 0.28);
  --warn: #FBBF24;  --warn-soft: rgba(251, 191, 36, 0.12); --warn-line: rgba(251, 191, 36, 0.28);
  --bad: #F87171;   --bad-soft: rgba(248, 113, 113, 0.12); --bad-line: rgba(248, 113, 113, 0.28);

  --font-sans: 'Inter', 'Noto Sans SC', 'PingFang SC', 'HarmonyOS Sans SC', 'Microsoft YaHei', system-ui, sans-serif;
  --font-display: 'Inter', 'Noto Sans SC', 'PingFang SC', sans-serif;
  --font-mono: 'JetBrains Mono', 'SF Mono', Menlo, monospace;

  --h-header: 60px;
  --h-tabs: 56px;
  --h-total: 116px;
  --w-container: 1320px;
  --w-sidebar: 232px;

  --r-sm: 6px; --r: 10px; --r-lg: 16px;
  --shadow: 0 1px 0 rgba(255,255,255,0.04), 0 8px 24px rgba(0,0,0,0.3);
}

/* ============================== Typography ============================== */
.display { font-family: var(--font-display); font-weight: 800; letter-spacing: -0.02em; }
.mono { font-family: var(--font-mono); font-variant-ligatures: none; }
h1 { font-weight: 800; letter-spacing: -0.03em; line-height: 1.05; }
h2 { font-weight: 700; letter-spacing: -0.022em; line-height: 1.15; }
h3 { font-weight: 700; letter-spacing: -0.014em; line-height: 1.25; }
h4 { font-weight: 700; letter-spacing: -0.01em; line-height: 1.3; }
p { color: var(--text-2); }
a { color: inherit; text-decoration: none; }

/* ============================== Header ============================== */
.site-header {
  position: sticky; top: 0; z-index: 100; height: var(--h-header);
  background: rgba(10,10,10,0.84);
  backdrop-filter: blur(20px) saturate(140%);
  -webkit-backdrop-filter: blur(20px) saturate(140%);
  border-bottom: 1px solid var(--line-soft);
}
.site-header .inner {
  max-width: var(--w-container); margin: 0 auto; padding: 0 28px;
  height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 24px;
}
.brand { display: flex; align-items: center; gap: 12px; }
.brand-mark {
  width: 28px; height: 28px; background: var(--yellow-pure); color: #000;
  font-family: var(--font-display); font-weight: 800; letter-spacing: -0.025em; font-size: 19px;
  display: flex; align-items: center; justify-content: center;
  border-radius: 6px; letter-spacing: -0.02em;
}
.brand-name {
  font-weight: 600; font-size: 14px; letter-spacing: -0.01em;
  display: flex; gap: 8px; align-items: baseline;
}
.brand-name .sub { color: var(--text-3); font-weight: 400; font-size: 12px; }
.header-actions { display: flex; align-items: center; gap: 10px; }
.lang-toggle {
  display: inline-flex; background: var(--bg-2); border: 1px solid var(--line);
  border-radius: 7px; padding: 2px;
}
.lang-toggle button {
  background: transparent; border: 0; color: var(--text-3);
  padding: 4px 10px; cursor: pointer; border-radius: 5px;
  font-family: var(--font-mono); font-size: 11px; font-weight: 500;
  letter-spacing: 0.05em; transition: all 0.15s;
}
.lang-toggle button.active { background: var(--text); color: #000; }
.cta-btn {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 7px 14px; background: var(--yellow-pure); color: #000;
  border: 0; border-radius: 7px; font-size: 13px; font-weight: 600;
  letter-spacing: -0.005em; cursor: pointer; transition: all 0.15s;
  text-decoration: none;
}
.cta-btn:hover { background: #fff; transform: translateY(-1px); }

/* ============================== Top Nav (Tabs) ============================== */
.tab-nav {
  position: sticky; top: var(--h-header); z-index: 90; height: var(--h-tabs);
  background: rgba(10,10,10,0.92); backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--line-soft);
}
.tab-nav .inner {
  max-width: var(--w-container); margin: 0 auto; padding: 0 28px;
  height: 100%; display: flex; align-items: center; gap: 4px;
  overflow-x: auto; scrollbar-width: none;
}
.tab-nav .inner::-webkit-scrollbar { display: none; }
.tab-btn {
  flex-shrink: 0;
  background: transparent; border: 0; color: var(--text-3);
  padding: 10px 14px; cursor: pointer; font-size: 13.5px; font-weight: 500;
  display: inline-flex; align-items: center; gap: 8px;
  border-radius: 7px; transition: all 0.15s; position: relative;
}
.tab-btn .ico { font-size: 14px; opacity: 0.9; }
.tab-btn:hover { color: var(--text-2); background: var(--bg-1); }
.tab-btn.active { color: var(--text); }
.tab-btn.active::after {
  content: ''; position: absolute; left: 14px; right: 14px;
  bottom: -10px; height: 2px; background: var(--yellow);
  border-radius: 2px 2px 0 0;
}

/* ============================== Layout ============================== */
.layout {
  max-width: var(--w-container); margin: 0 auto; padding: 0 28px;
  display: grid; grid-template-columns: var(--w-sidebar) 1fr;
  gap: 48px; align-items: start;
}
.sidebar {
  position: sticky; top: var(--h-total);
  padding: 32px 0 64px;
  max-height: calc(100vh - var(--h-total));
  overflow-y: auto;
  scrollbar-width: thin; scrollbar-color: var(--line) transparent;
}
.sidebar::-webkit-scrollbar { width: 4px; }
.sidebar::-webkit-scrollbar-thumb { background: var(--line); border-radius: 4px; }
.sidebar-section { display: none; }
.sidebar-section.active { display: block; }
.sidebar-label {
  font-family: var(--font-mono); font-size: 10.5px;
  letter-spacing: 0.15em; text-transform: uppercase;
  color: var(--text-4); padding: 0 12px 12px;
  border-bottom: 1px solid var(--line-soft); margin-bottom: 12px;
}
.sidebar a {
  display: block; padding: 7px 12px; font-size: 13px; color: var(--text-3);
  border-left: 2px solid transparent; margin-left: -2px;
  transition: all 0.15s; line-height: 1.4;
}
.sidebar a:hover { color: var(--text); }
.sidebar a.active { color: var(--yellow); border-left-color: var(--yellow); }
.sidebar a.indent { padding-left: 28px; font-size: 12.5px; color: var(--text-4); }
.sidebar a.indent.active { color: var(--yellow); }

.main { padding: 48px 0 120px; min-width: 0; }
.tab-panel { display: none; }
.tab-panel.active { display: block; animation: fadeUp 0.32s cubic-bezier(0.2, 0.7, 0.2, 1); }
@keyframes fadeUp { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

section.block { margin-bottom: 88px; }
section.block:last-child { margin-bottom: 0; }

.eyebrow {
  font-family: var(--font-mono); font-size: 11px;
  color: var(--yellow); letter-spacing: 0.15em; text-transform: uppercase;
  margin-bottom: 14px; display: inline-flex; align-items: center; gap: 8px;
}
.eyebrow::before { content: ''; width: 6px; height: 6px; background: var(--yellow); border-radius: 50%; }
.section-title {
  font-size: 32px; margin-bottom: 14px; font-weight: 700; letter-spacing: -0.025em;
}
.section-title em {
  font-style: normal; font-weight: 800;
  font-size: 1em; color: var(--yellow); margin: 0;
}
.section-lead {
  font-size: 16px; color: var(--text-2); max-width: 720px;
  margin-bottom: 36px; line-height: 1.6;
}

/* ============================== Hero ============================== */
.hero {
  padding: 80px 0 60px; position: relative;
  border-bottom: 1px solid var(--line-soft); margin-bottom: 72px;
}
.hero::before {
  content: ''; position: absolute; left: -120px; top: 0;
  width: 540px; height: 540px;
  background: radial-gradient(circle, var(--yellow-soft) 0%, transparent 60%);
  pointer-events: none; z-index: -1; filter: blur(30px);
}
.hero-meta {
  font-family: var(--font-mono); font-size: 11px;
  letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--text-3); margin-bottom: 28px;
  display: flex; flex-wrap: wrap; gap: 14px; align-items: center;
}
.hero-meta .dot { width: 4px; height: 4px; border-radius: 50%; background: var(--text-4); }
.hero h1 {
  font-size: clamp(40px, 5.6vw, 68px); line-height: 1.06;
  margin-bottom: 28px; font-weight: 800; letter-spacing: -0.035em;
}
.hero h1 em {
  font-style: normal; font-weight: 800;
  color: var(--yellow); font-size: 1em; padding: 0;
}
.hero-desc {
  font-size: 18px; color: var(--text-2);
  max-width: 700px; line-height: 1.55; margin-bottom: 44px;
}
.stat-row {
  display: grid; grid-template-columns: repeat(4, 1fr);
  border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
}
.stat { padding: 22px 24px; border-right: 1px solid var(--line); }
.stat:last-child { border-right: 0; }
.stat-num {
  font-family: var(--font-display); font-weight: 800; letter-spacing: -0.025em; font-size: 38px; line-height: 1; color: var(--yellow);
  margin-bottom: 8px; letter-spacing: -0.01em;
}
.stat-num .unit {
  font-family: var(--font-sans); font-style: normal;
  font-size: 18px; color: var(--text-3); margin-left: 2px;
}
.stat-label {
  font-family: var(--font-mono); font-size: 11px;
  letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-3);
}

/* ============================== Grids & Cards ============================== */
.grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
.grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
.grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }

.card {
  background: var(--bg-1); border: 1px solid var(--line);
  border-radius: var(--r); padding: 22px; transition: all 0.2s;
}
.card:hover { border-color: var(--line-strong); transform: translateY(-2px); }

/* 能力分层专用 — 数字与标题同一行 */
.layer-card {
  background: var(--bg-1); border: 1px solid var(--line);
  border-radius: var(--r); padding: 22px; transition: all 0.2s;
  display: grid;
  grid-template-columns: auto 1fr;
  column-gap: 16px;
  align-items: center;
  row-gap: 0;
}
.layer-card:hover { border-color: var(--line-strong); transform: translateY(-2px); }
.layer-card .lc-num {
  font-family: var(--font-display); font-weight: 800; letter-spacing: -0.04em;
  font-size: 30px; line-height: 1;
  grid-row: 1; grid-column: 1;
}
.layer-card .lc-num .pct { font-size: 16px; opacity: 0.8; margin-left: 1px; }
.layer-card h4 {
  font-size: 15.5px; margin: 0;
  grid-row: 1; grid-column: 2;
}
.layer-card p {
  font-size: 12.5px; color: var(--text-3); line-height: 1.55;
  grid-row: 2; grid-column: 1 / -1; margin-top: 14px;
}

.pain-card, .value-card {
  background: var(--bg-1); border: 1px solid var(--line);
  border-radius: var(--r); padding: 22px; position: relative; overflow: hidden;
}
.pain-card, .value-card {
  display: grid;
  grid-template-columns: auto 1fr;
  column-gap: 14px;
  row-gap: 0;
  align-items: center;
}
.pain-card::before, .value-card::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
}
.pain-card::before { background: var(--bad); opacity: 0.7; }
.value-card::before { background: var(--yellow); }
.pain-card .icon, .value-card .icon {
  font-family: var(--font-display); font-weight: 800; letter-spacing: -0.025em;
  font-size: 22px; line-height: 1; margin-bottom: 0;
  grid-column: 1; align-self: center;
}
.pain-card .icon { color: var(--bad); opacity: 0.85; grid-row: 1; }
.value-card .icon { color: var(--yellow); grid-row: 2; }
.pain-card h4, .value-card h4 {
  font-size: 15.5px; margin-bottom: 0;
  grid-column: 2;
}
.pain-card h4 { grid-row: 1; }
.value-card h4 { grid-row: 2; }
.pain-card p, .value-card p {
  font-size: 13px; color: var(--text-3); line-height: 1.55;
  grid-column: 1 / -1; margin-top: 12px;
}
.pain-card p { grid-row: 2; }
.value-card p { grid-row: 3; }
.pain-card ul, .value-card ul {
  grid-column: 1 / -1; margin-top: 14px;
  list-style: none; padding: 0;
}
.pain-card ul { grid-row: 2; }
.value-card ul { grid-row: 3; }
.pain-card ul li, .value-card ul li {
  font-size: 12.5px; color: var(--text-3); line-height: 1.55;
  padding: 6px 0 6px 16px; position: relative;
  border-top: 1px solid var(--line-soft);
}
.pain-card ul li:first-child, .value-card ul li:first-child { border-top: 0; padding-top: 4px; }
.pain-card ul li::before, .value-card ul li::before {
  content: '·'; position: absolute; left: 4px; top: 4px;
  color: var(--bad); font-weight: 700; font-size: 18px; line-height: 1;
}
.value-card ul li::before { color: var(--yellow); }
.pain-card ul li b, .value-card ul li b {
  color: var(--text-2); font-weight: 600; display: inline;
}
.value-card .tag {
  font-family: var(--font-mono); font-size: 10.5px;
  letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--yellow); display: block;
  grid-row: 1; grid-column: 1 / -1; margin-bottom: 8px;
}

/* ============================== Tables ============================== */
.t {
  width: 100%; border-collapse: collapse; font-size: 13px;
  background: var(--bg-1); border: 1px solid var(--line);
  border-radius: var(--r); overflow: hidden;
}
.t thead { background: var(--bg-2); }
.t th {
  text-align: left; padding: 12px 16px; font-weight: 600; font-size: 12px;
  color: var(--text); letter-spacing: 0.02em;
  border-right: 1px solid var(--line); border-bottom: 1px solid var(--line);
}
.t th:last-child { border-right: 0; }
.t td {
  padding: 13px 16px;
  border-top: 1px solid var(--line-soft);
  border-right: 1px solid var(--line-soft);
  color: var(--text-2); vertical-align: top; line-height: 1.5;
}
.t td:last-child { border-right: 0; }
.t tbody tr:hover { background: var(--bg-2); }
.t td.mono { font-family: var(--font-mono); font-size: 12px; color: var(--text); }
.t td.dim { color: var(--text-3); }
.t .row-num {
  font-family: var(--font-mono); font-size: 11px;
  color: var(--text-4); width: 28px; text-align: center;
}
.t td.yes { color: var(--ok); font-weight: 500; }
.t td.no { color: var(--bad); }
.t td.partial { color: var(--warn); }
.t code { font-size: 11.5px; }

/* ============================== Path matrix (合并对比表) ============================== */
.path-matrix { background: var(--bg-1); border: 1px solid var(--line); border-radius: var(--r); overflow: hidden; width: 100%; }
.path-matrix table { width: 100%; border-collapse: collapse; font-size: 13px; }
.path-matrix thead th {
  background: var(--bg-2); text-align: left; vertical-align: top;
  padding: 16px 14px; border-right: 1px solid var(--line); border-bottom: 2px solid var(--line);
  color: var(--text); font-weight: 600;
}
.path-matrix thead th:last-child { border-right: 0; }
.path-matrix thead .col-num {
  font-family: var(--font-display); font-weight: 800; letter-spacing: -0.03em;
  font-size: 22px; line-height: 1; color: var(--text-3); display: block; margin-bottom: 4px;
}
.path-matrix thead .col-name { font-size: 14px; display: block; }
.path-matrix thead .col-tag {
  font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.1em;
  text-transform: uppercase; color: var(--text-3); display: block; margin-top: 4px;
}

/* Langfuse 列整列高亮 */
.path-matrix th.col-best,
.path-matrix td.col-best {
  background: var(--yellow-soft);
  border-left: 2px solid var(--yellow);
  border-right: 2px solid var(--yellow);
  color: var(--text);
}
.path-matrix th.col-best { position: relative; }
.path-matrix th.col-best .col-num { color: var(--yellow); }
.path-matrix th.col-best .col-tag { color: var(--yellow); font-weight: 700; }
.path-matrix th.col-best::before {
  content: '✦ RECOMMENDED'; position: absolute; top: -1px; left: 0; right: 0;
  font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.18em;
  color: #000; background: var(--yellow); padding: 2px 0;
  text-align: center; font-weight: 700;
}
.path-matrix thead th.col-best { padding-top: 24px; }

.path-matrix td {
  padding: 13px 14px;
  border-right: 1px solid var(--line-soft); border-top: 1px solid var(--line-soft);
  color: var(--text-2); vertical-align: top; line-height: 1.55;
}
.path-matrix td:last-child { border-right: 0; }
.path-matrix td.col-best { color: var(--text); font-weight: 500; }
.path-matrix td.col-best b { color: var(--yellow); font-weight: 600; }

.path-matrix .row-label {
  font-family: var(--font-mono); font-size: 10.5px;
  letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--text-3); padding-top: 14px; width: 110px;
  background: var(--bg-2); border-right: 2px solid var(--line);
}
.path-matrix .row-label-en {
  display: block; font-size: 9.5px; color: var(--text-4); margin-top: 2px;
}

/* 分段分隔线：上半段（叙事）下方一条更粗的线 */
.path-matrix tr.section-break td { border-top: 2px solid var(--line); }

/* 段头行：浅黄背景 + 左侧黄色竖条 + mono 小标签 */
.path-matrix tr.section-header td {
  background: rgba(252,255,116,0.06);
  border-top: 2px solid var(--line);
  border-bottom: 1px solid var(--yellow-line);
  padding: 10px 14px;
  font-family: var(--font-mono);
  font-size: 10.5px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--yellow);
  font-weight: 700;
  position: relative;
}
.path-matrix tr.section-header td::before {
  content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--yellow);
}
.path-matrix tr.section-header td .sh-zh { color: var(--yellow); margin-right: 12px; }
.path-matrix tr.section-header td .sh-en { color: var(--text-3); font-size: 9.5px; }

/* 短答 cell */
.path-matrix td.dash { color: var(--text-4); text-align: center; font-family: var(--font-mono); }
.path-matrix td.partial { color: var(--warn); font-size: 12px; }
.path-matrix td.deny { color: var(--bad); font-size: 12px; }
.path-matrix td.ok-cell { color: var(--ok); font-size: 12px; }
.path-matrix td.ok-cell .check { font-weight: 700; margin-right: 3px; }

/* 结论行：浅黄底 */
.path-matrix tr.conclusion-row td { background: var(--bg-2); border-top: 2px solid var(--line); font-weight: 500; }
.path-matrix tr.conclusion-row td.col-best { background: rgba(252,255,116,0.14); }
.path-matrix tr.conclusion-row .row-label { color: var(--yellow); }

@media (max-width: 1080px) {
  .path-matrix { overflow-x: auto; }
  .path-matrix table { min-width: 900px; }
}

/* ============================== Badges ============================== */
.badge {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 3px 9px; border-radius: 999px;
  font-family: var(--font-mono); font-size: 10.5px;
  letter-spacing: 0.03em; font-weight: 500;
  border: 1px solid transparent; white-space: nowrap;
}
.badge .b-dot { width: 5.5px; height: 5.5px; border-radius: 50%; }
.badge.ok   { background: var(--ok-soft);   color: var(--ok);   border-color: var(--ok-line);   }
.badge.warn { background: var(--warn-soft); color: var(--warn); border-color: var(--warn-line); }
.badge.bad  { background: var(--bad-soft);  color: var(--bad);  border-color: var(--bad-line);  }
.badge.o1   { background: var(--o1-soft);   color: var(--o1);   border-color: var(--o1-line);   }
.badge.o2   { background: var(--o2-soft);   color: var(--o2);   border-color: var(--o2-line);   }
.badge.o3   { background: var(--o3-soft);   color: var(--o3);   border-color: var(--o3-line);   }
.badge.o4   { background: var(--o4-soft);   color: var(--o4);   border-color: var(--o4-line);   }
.badge.ok .b-dot   { background: var(--ok); }
.badge.warn .b-dot { background: var(--warn); }
.badge.bad .b-dot  { background: var(--bad); }
.badge.o1 .b-dot { background: var(--o1); }
.badge.o2 .b-dot { background: var(--o2); }
.badge.o3 .b-dot { background: var(--o3); }
.badge.o4 .b-dot { background: var(--o4); }

/* ============================== OKR Cards ============================== */
.okr-card {
  background: var(--bg-1); border: 1px solid var(--line);
  border-radius: var(--r-lg); padding: 28px;
  position: relative; overflow: hidden; margin-bottom: 24px;
}
.okr-card[data-o="1"] { --c: var(--o1); --c-soft: var(--o1-soft); --c-line: var(--o1-line); }
.okr-card[data-o="2"] { --c: var(--o2); --c-soft: var(--o2-soft); --c-line: var(--o2-line); }
.okr-card[data-o="3"] { --c: var(--o3); --c-soft: var(--o3-soft); --c-line: var(--o3-line); }
.okr-card[data-o="4"] { --c: var(--o4); --c-soft: var(--o4-soft); --c-line: var(--o4-line); }
.okr-card::before {
  content: ''; position: absolute; top: 0; left: 0;
  width: 4px; height: 100%; background: var(--c);
}
.okr-header { display: flex; align-items: flex-start; gap: 22px; margin-bottom: 24px; }
.okr-num {
  font-family: var(--font-display); font-weight: 800; letter-spacing: -0.025em; font-size: 64px; line-height: 0.85;
  color: var(--c); letter-spacing: -0.02em;
  flex-shrink: 0; min-width: 70px;
}
.okr-title-block { flex: 1; padding-top: 8px; }
.okr-eyebrow {
  font-family: var(--font-mono); font-size: 11px;
  letter-spacing: 0.15em; text-transform: uppercase;
  color: var(--c); margin-bottom: 6px;
}
.okr-title {
  font-size: 22px; font-weight: 700;
  letter-spacing: -0.02em; line-height: 1.25; margin-bottom: 8px;
}
.okr-desc { font-size: 14px; color: var(--text-3); line-height: 1.55; }

.kr-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
.kr-mini {
  background: var(--bg-2); border: 1px solid var(--line);
  border-left: 2px solid var(--c);
  border-radius: var(--r-sm); padding: 14px 16px;
}
.kr-mini .kr-id {
  font-family: var(--font-mono); font-size: 10.5px;
  color: var(--c); letter-spacing: 0.05em; font-weight: 500;
  margin-bottom: 4px;
}
.kr-mini h5 { font-size: 13.5px; font-weight: 600; margin-bottom: 8px; line-height: 1.4; }
.kr-mini .kr-metrics { display: flex; flex-wrap: wrap; gap: 6px; }
.kr-mini .metric-chip {
  font-family: var(--font-mono); font-size: 10.5px; color: var(--text-3);
  background: var(--bg-3); padding: 2px 8px; border-radius: 3px;
}

/* ============================== KR Walkthrough (Tab 3) ============================== */
.kr-walk { margin-bottom: 10px; }
.kr-walk details {
  background: var(--bg-1); border: 1px solid var(--line);
  border-radius: var(--r); overflow: hidden; transition: border-color 0.2s;
}
.kr-walk details[open] { border-color: var(--line-strong); }
.kr-walk summary {
  padding: 16px 20px; cursor: pointer;
  display: flex; align-items: center; gap: 14px;
  list-style: none; user-select: none; transition: background 0.15s;
}
.kr-walk summary::-webkit-details-marker { display: none; }
.kr-walk summary:hover { background: var(--bg-2); }
.kr-walk summary .caret {
  font-family: var(--font-mono); color: var(--text-4);
  font-size: 11px; transition: transform 0.2s;
}
.kr-walk details[open] summary .caret { transform: rotate(90deg); color: var(--yellow); }
.kr-walk .kr-id-tag {
  font-family: var(--font-mono); font-size: 11px; font-weight: 500;
  padding: 3px 8px; border-radius: 4px;
  background: var(--bg-3); color: var(--text-2);
  letter-spacing: 0.04em;
}
.kr-walk[data-o="1"] .kr-id-tag { color: var(--o1); background: var(--o1-soft); }
.kr-walk[data-o="2"] .kr-id-tag { color: var(--o2); background: var(--o2-soft); }
.kr-walk[data-o="3"] .kr-id-tag { color: var(--o3); background: var(--o3-soft); }
.kr-walk[data-o="4"] .kr-id-tag { color: var(--o4); background: var(--o4-soft); }
.kr-walk summary h4 { flex: 1; font-size: 14.5px; font-weight: 600; }
.kr-walk .kr-body { padding: 6px 20px 24px; border-top: 1px solid var(--line-soft); }
.kr-section { margin-top: 18px; }
.kr-section-head {
  font-family: var(--font-mono); font-size: 10.5px;
  letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--text-3); margin-bottom: 8px;
  display: flex; align-items: center; gap: 8px;
}
.kr-section-head .em { font-size: 13px; }
.kr-section[data-kind="goal"] .kr-section-head .em { color: var(--yellow); }
.kr-section[data-kind="see"] .kr-section-head .em { color: var(--o1); }
.kr-section[data-kind="now"] .kr-section-head .em { color: var(--o2); }
.kr-section[data-kind="next"] .kr-section-head .em { color: var(--o3); }
.kr-section ul { padding-left: 18px; }
.kr-section li { font-size: 13.5px; color: var(--text-2); margin-bottom: 5px; line-height: 1.55; }
.kr-section li::marker { color: var(--text-4); }
.kr-section .kr-text { font-size: 13.5px; color: var(--text-2); line-height: 1.6; }

.ext-link { color: var(--text-2); border-bottom: 1px dashed var(--yellow-line); transition: all 0.15s; }
.ext-link:hover { color: var(--yellow); border-bottom-color: var(--yellow); }
.ext-link code { color: inherit; background: var(--bg-3); border: 1px solid var(--line); padding: 1px 6px; border-radius: 3px; font-size: 0.88em; }
.ext-link:hover code { border-color: var(--yellow-line); background: var(--bg-2); }

/* ============================== Data source cards (KR see) ============================== */
.data-sources { display: grid; gap: 10px; margin-top: 2px; }
.data-source {
  background: var(--bg-2); border: 1px solid var(--line);
  border-left: 3px solid var(--ds-c, var(--yellow));
  border-radius: var(--r); padding: 14px 18px;
}
.data-source[data-role="primary"]   { --ds-c: var(--yellow); }
.data-source[data-role="crosscheck"] { --ds-c: var(--o1); }
.data-source[data-role="drilldown"]  { --ds-c: var(--o4); }
.data-source[data-role="alerting"]   { --ds-c: var(--o3); }
.ds-head {
  display: flex; align-items: baseline; gap: 10px;
  margin-bottom: 10px; flex-wrap: wrap;
}
.ds-role {
  font-family: var(--font-mono); font-size: 10px;
  letter-spacing: 0.15em; text-transform: uppercase;
  color: var(--ds-c); font-weight: 600;
  padding: 2px 7px; background: rgba(255,255,255,0.02);
  border: 1px solid var(--line); border-radius: 3px;
}
.ds-title {
  font-size: 13.5px; font-weight: 600; color: var(--text);
  letter-spacing: -0.005em;
}
.ds-title .ext-link { border-bottom: 1px dashed var(--ds-c); }
.ds-title .ext-link:hover { color: var(--ds-c); border-bottom-color: var(--ds-c); }
.ds-title .arr-out { color: var(--ds-c); font-size: 11px; margin-left: 2px; }
.ds-rows {
  display: grid; grid-template-columns: 56px 1fr;
  gap: 7px 14px; align-items: baseline;
}
.ds-rows dt {
  font-family: var(--font-mono); font-size: 10px;
  letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--text-4); padding-top: 1px;
}
.ds-rows dd { font-size: 13px; color: var(--text-2); line-height: 1.55; }
.ds-rows dd code { font-size: 11.5px; }
.ds-rows dd b { color: var(--text); font-weight: 600; }
.ds-rows dd .hit { color: var(--yellow); font-weight: 600; }
@media (max-width: 640px) {
  .ds-rows { grid-template-columns: 1fr; gap: 2px 0; }
  .ds-rows dt { margin-top: 8px; }
}

code, .code-inline {
  font-family: var(--font-mono); font-size: 0.88em;
  background: var(--bg-3); color: var(--yellow);
  padding: 1px 6px; border-radius: 3px; border: 1px solid var(--line);
}

/* ============================== Callouts ============================== */
.callout {
  background: var(--bg-1); border: 1px solid var(--line);
  border-left: 3px solid var(--yellow);
  border-radius: var(--r); padding: 18px 22px;
  margin: 18px 0; position: relative;
}
.callout.danger { border-left-color: var(--bad); background: var(--bad-soft); }
.callout.danger .callout-label { color: var(--bad); }
.callout.warn { border-left-color: var(--warn); background: var(--warn-soft); }
.callout.warn .callout-label { color: var(--warn); }
.callout.info { border-left-color: var(--o1); background: var(--o1-soft); }
.callout.info .callout-label { color: var(--o1); }
.callout-label {
  font-family: var(--font-mono); font-size: 10.5px;
  letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--yellow); font-weight: 600;
  margin-bottom: 6px; display: block;
}
.callout p { font-size: 13.5px; color: var(--text); line-height: 1.6; }
.callout .ev {
  font-family: var(--font-mono); font-size: 12px; color: var(--text);
  background: var(--bg-3); padding: 8px 12px; border-radius: 4px;
  margin-top: 10px; display: block; line-height: 1.6;
  border: 1px solid var(--line); overflow-x: auto; white-space: nowrap;
}

/* ============================== Code blocks ============================== */
pre.code {
  background: var(--bg-1); border: 1px solid var(--line);
  border-radius: var(--r); padding: 14px 18px;
  font-family: var(--font-mono); font-size: 12.5px; line-height: 1.65;
  color: var(--text-2); overflow-x: auto;
  margin: 10px 0; position: relative;
}
pre.code .cm { color: var(--text-4); }
pre.code .kw { color: var(--yellow); }
pre.code .st { color: #b5ce8a; }
pre.code .nu { color: var(--o1); }
pre.code .fl { color: var(--o3); }
pre.code .pn { color: var(--o4); }

/* ============================== Deploy steps ============================== */
.steps { counter-reset: step; }
.step {
  background: var(--bg-1); border: 1px solid var(--line);
  border-radius: var(--r-lg); padding: 28px;
  margin-bottom: 16px; position: relative;
}
.step::before {
  counter-increment: step; content: counter(step, decimal-leading-zero);
  position: absolute; top: 24px; right: 28px;
  font-family: var(--font-display); font-weight: 800; letter-spacing: -0.025em; font-size: 56px; line-height: 1; color: var(--yellow);
  opacity: 0.22; letter-spacing: -0.02em;
}
.step-eyebrow {
  font-family: var(--font-mono); font-size: 11px;
  letter-spacing: 0.15em; text-transform: uppercase;
  color: var(--yellow); margin-bottom: 8px;
}
.step h3 { font-size: 20px; margin-bottom: 8px; }
.step .step-desc { font-size: 14px; color: var(--text-3); margin-bottom: 16px; max-width: 720px; }

/* ============================== Comparison ============================== */
.quadrant {
  background: var(--bg-1); border: 1px solid var(--line);
  border-radius: var(--r-lg); padding: 56px 32px 36px;
  position: relative;
}
.q-grid {
  position: relative; aspect-ratio: 1.4 / 1;
  max-width: 760px; margin: 0 auto;
}
.q-axis-x, .q-axis-y { position: absolute; background: var(--line-strong); }
.q-axis-x { left: 0; right: 0; top: 50%; height: 1px; }
.q-axis-y { top: 0; bottom: 0; left: 50%; width: 1px; }
.q-axis-label {
  position: absolute; font-family: var(--font-mono); font-size: 10.5px;
  letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-3);
}
.q-axis-label.top { top: -24px; left: 50%; transform: translateX(-50%); }
.q-axis-label.bottom { bottom: -24px; left: 50%; transform: translateX(-50%); }
.q-axis-label.left {
  left: -38px; top: 50%; transform: rotate(-90deg) translateX(50%);
  transform-origin: left center; white-space: nowrap;
}
.q-axis-label.right {
  right: -38px; top: 50%; transform: rotate(-90deg) translateX(50%);
  transform-origin: right center; white-space: nowrap;
}
.q-quad-label {
  position: absolute; font-family: var(--font-mono); font-size: 10px;
  letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-4);
}
.q-quad-label.tl { top: 12px; left: 18px; }
.q-quad-label.tr { top: 12px; right: 18px; }
.q-quad-label.bl { bottom: 12px; left: 18px; }
.q-quad-label.br { bottom: 12px; right: 18px; }
.q-point {
  position: absolute; transform: translate(-50%, -50%);
  background: var(--bg-2); border: 1px solid var(--line-strong);
  border-radius: 999px; padding: 6px 14px;
  font-size: 12px; font-weight: 500; white-space: nowrap;
  z-index: 2;
}
.q-point.hero {
  background: var(--yellow); color: #000;
  border-color: var(--yellow); font-weight: 700;
  box-shadow: 0 0 0 6px var(--yellow-soft);
}

/* Decision tree */
.tree {
  background: var(--bg-1); border: 1px solid var(--line);
  border-radius: var(--r-lg); padding: 28px;
}
.tree-row { display: flex; gap: 16px; align-items: center; margin-bottom: 14px; }
.tree-q {
  background: var(--bg-2); border: 1px solid var(--line);
  padding: 14px 18px; border-radius: var(--r);
  flex: 1; font-size: 14px;
}
.tree-q .q-text { color: var(--text); font-weight: 500; }
.tree-q .q-hint { color: var(--text-3); font-size: 12px; margin-top: 4px; }
.tree-arrow { font-family: var(--font-mono); color: var(--text-4); font-size: 14px; flex-shrink: 0; }
.tree-a {
  font-family: var(--font-mono); font-size: 11.5px; font-weight: 600;
  padding: 6px 12px; border-radius: 5px; flex-shrink: 0; letter-spacing: 0.05em;
  width: 260px; text-align: left;
}
.tree-a.no { background: var(--bad-soft); color: var(--bad); border: 1px solid var(--bad-line); }
.tree-a.yes { background: var(--ok-soft); color: var(--ok); border: 1px solid var(--ok-line); }

/* Path cards */
.path {
  background: var(--bg-1); border: 1px solid var(--line);
  border-radius: var(--r-lg); padding: 24px; margin-bottom: 14px;
  position: relative; overflow: hidden;
}
.path.recommended {
  border-color: var(--yellow-line);
  background: linear-gradient(180deg, var(--yellow-soft) 0%, var(--bg-1) 100%);
}
.path.recommended::before {
  content: '✦ RECOMMENDED'; position: absolute;
  top: 14px; right: 18px;
  font-family: var(--font-mono); font-size: 10px;
  letter-spacing: 0.15em; color: var(--yellow);
  font-weight: 700;
}
.path-head { display: flex; align-items: baseline; gap: 14px; margin-bottom: 14px; }
.path-num {
  font-family: var(--font-display); font-weight: 800; letter-spacing: -0.025em; font-size: 32px; color: var(--text-3); line-height: 1;
}
.path.recommended .path-num { color: var(--yellow); }
.path h4 { font-size: 18px; }
.path-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 28px; margin-top: 12px; }
.path-grid .col h6 {
  font-family: var(--font-mono); font-size: 10.5px;
  letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--text-3); margin-bottom: 6px;
}
.path-grid .col p { font-size: 13px; color: var(--text-2); line-height: 1.55; }
.path .conclusion {
  margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--line);
  font-size: 13px; color: var(--text);
}
.path .conclusion .label {
  font-family: var(--font-mono); font-size: 10.5px;
  letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--yellow); margin-right: 8px;
}

/* ============================== Architecture ============================== */
.arch-wrap {
  background: var(--bg-1); border: 1px solid var(--line);
  border-radius: var(--r-lg); padding: 36px; overflow: hidden;
}
.arch-svg { width: 100%; height: auto; display: block; }

/* ============================== Status bar ============================== */
.status-bar {
  display: flex; height: 64px; border-radius: var(--r);
  overflow: hidden; border: 1px solid var(--line);
  font-family: var(--font-mono); margin-bottom: 8px;
}
.status-bar .seg {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  font-size: 11px; font-weight: 600; padding: 8px 12px;
}
.status-bar .seg.ok { background: var(--ok-soft); color: var(--ok); }
.status-bar .seg.warn { background: var(--warn-soft); color: var(--warn); }
.status-bar .seg.bad { background: var(--bad-soft); color: var(--bad); }
.status-bar .seg .num { font-size: 22px; line-height: 1; margin-bottom: 3px; font-family: var(--font-display); font-weight: 800; letter-spacing: -0.02em; }
.status-legend {
  font-family: var(--font-mono); font-size: 11px;
  color: var(--text-3); display: flex; gap: 18px;
}

/* ============================== Storyboard ============================== */
.story {
  display: grid; grid-template-columns: 1fr 1fr; gap: 0;
  background: var(--bg-1); border: 1px solid var(--line);
  border-radius: var(--r-lg); overflow: hidden;
}
.story-side { padding: 28px; position: relative; }
.story-side.bad { background: linear-gradient(180deg, var(--bad-soft) 0%, transparent 100%); }
.story-side.good { background: linear-gradient(180deg, var(--ok-soft) 0%, transparent 100%); border-left: 1px solid var(--line); }
.story-side h4 { font-size: 18px; margin-bottom: 4px; }
.story-side .story-eyebrow {
  font-family: var(--font-mono); font-size: 10.5px;
  letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 6px;
}
.story-side.bad .story-eyebrow { color: var(--bad); }
.story-side.good .story-eyebrow { color: var(--ok); }
.story-side .meta {
  font-family: var(--font-mono); font-size: 11px;
  color: var(--text-3); margin-bottom: 18px;
}
.story-step {
  display: flex; gap: 12px; margin-bottom: 10px;
  padding-bottom: 10px; border-bottom: 1px dashed var(--line-soft);
}
.story-step:last-child { border-bottom: 0; }
.story-time {
  font-family: var(--font-mono); font-size: 11px;
  color: var(--text-4); flex-shrink: 0; min-width: 50px;
}
.story-text { font-size: 13px; color: var(--text-2); line-height: 1.5; }
.story-text strong { color: var(--text); }

/* ============================== Bar chart ============================== */
.bar-chart {
  background: var(--bg-1); border: 1px solid var(--line);
  border-radius: var(--r-lg); padding: 28px;
}
.bar-row {
  display: grid; grid-template-columns: 64px 1fr 110px;
  gap: 16px; align-items: center;
  padding: 8px 0; border-bottom: 1px dashed var(--line-soft);
}
.bar-row:last-child { border-bottom: 0; }
.bar-label { font-family: var(--font-mono); font-size: 12px; color: var(--text-3); }
.bar-track { background: var(--bg-3); height: 16px; border-radius: 3px; position: relative; overflow: hidden; }
.bar-fill { height: 100%; background: linear-gradient(90deg, var(--o1), var(--yellow)); border-radius: 3px; }
.bar-fill.danger { background: linear-gradient(90deg, var(--warn), var(--bad)); }
.bar-value { font-family: var(--font-mono); font-size: 12px; color: var(--text); text-align: right; }

/* ============================== Resources ============================== */
.res-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
.res-card {
  background: var(--bg-1); border: 1px solid var(--line);
  border-radius: var(--r); padding: 18px 22px;
  display: flex; align-items: flex-start; gap: 14px;
  transition: all 0.2s; cursor: pointer;
}
.res-card:hover {
  border-color: var(--yellow-line); transform: translateY(-2px); background: var(--bg-2);
}
.res-card .res-ico {
  font-family: var(--font-display); font-weight: 800; letter-spacing: -0.025em; font-size: 26px; color: var(--yellow); line-height: 1; flex-shrink: 0;
}
.res-card h4 { font-size: 14.5px; margin-bottom: 4px; }
.res-card p { font-size: 12.5px; color: var(--text-3); margin-bottom: 4px; }
.res-card .url {
  font-family: var(--font-mono); font-size: 11.5px;
  color: var(--yellow); word-break: break-all;
}

/* ============================== Audience cards ============================== */
.audience-card {
  background: var(--bg-1); border: 1px solid var(--line);
  border-radius: var(--r-lg); padding: 26px;
  transition: all 0.2s; cursor: pointer;
}
.audience-card:hover {
  border-color: var(--yellow-line);
  background: linear-gradient(180deg, var(--yellow-soft), var(--bg-1));
}
.audience-card .role {
  font-family: var(--font-display); font-weight: 800; letter-spacing: -0.025em; font-size: 24px; color: var(--yellow); margin-bottom: 6px;
}
.audience-card .who { font-size: 13px; color: var(--text-3); margin-bottom: 14px; }
.audience-card h4 { font-size: 14px; margin-bottom: 10px; color: var(--text); line-height: 1.5; }
.audience-card .route {
