<script>
(function () {
  // ---------- Tab switching with URL hash ----------
  const tabBtns = document.querySelectorAll('.tab-btn');
  const tabPanels = document.querySelectorAll('.tab-panel');
  const sideSections = document.querySelectorAll('.sidebar-section');
  const VALID_TABS = ['overview', 'compare', 'design', 'demo', 'deploy', 'resources'];

  function switchTab(name, pushHash) {
    if (!VALID_TABS.includes(name)) name = 'overview';
    tabBtns.forEach(b => b.classList.toggle('active', b.dataset.tab === name));
    tabPanels.forEach(p => p.classList.toggle('active', p.id === 'tab-' + name));
    sideSections.forEach(s => s.classList.toggle('active', s.dataset.side === name));
    // reset sidebar active to first link
    sideSections.forEach(s => {
      if (s.dataset.side === name) {
        const links = s.querySelectorAll('a');
        links.forEach((a, i) => a.classList.toggle('active', i === 0));
      }
    });
    if (pushHash !== false) {
      try { history.replaceState(null, '', '#' + name); } catch (_) { /* srcdoc / sandboxed iframe */ }
    }
    window.scrollTo({ top: 0, behavior: 'instant' });
  }
  window.switchTab = switchTab; // expose for inline onclick

  tabBtns.forEach(b => {
    b.addEventListener('click', () => switchTab(b.dataset.tab));
  });

  // ---------- Hash on load ----------
  const initialHash = (location.hash || '#overview').slice(1);
  switchTab(initialHash, false);

  window.addEventListener('popstate', () => {
    const h = (location.hash || '#overview').slice(1);
    switchTab(h, false);
  });

  // ---------- Language toggle ----------
  const langBtns = document.querySelectorAll('.lang-toggle button');
  langBtns.forEach(b => {
    b.addEventListener('click', () => {
      const lang = b.dataset.langSet;
      document.body.dataset.lang = lang;
      document.documentElement.lang = lang === 'zh' ? 'zh-CN' : 'en';
      langBtns.forEach(x => x.classList.toggle('active', x.dataset.langSet === lang));
      try { localStorage.setItem('cc-obs-lang', lang); } catch (_) {}
    });
  });
  try {
    const savedLang = localStorage.getItem('cc-obs-lang');
    if (savedLang && (savedLang === 'zh' || savedLang === 'en')) {
      document.body.dataset.lang = savedLang;
      document.documentElement.lang = savedLang === 'zh' ? 'zh-CN' : 'en';
      langBtns.forEach(x => x.classList.toggle('active', x.dataset.langSet === savedLang));
    }
  } catch (_) {}

  // ---------- Scroll-spy: update sidebar active link per active tab ----------
  let spyRaf = null;
  function updateSpy() {
    spyRaf = null;
    const activePanel = document.querySelector('.tab-panel.active');
    if (!activePanel) return;
    const sections = activePanel.querySelectorAll('section[id]');
    const offset = 160;
    let current = null;
    sections.forEach(sec => {
      const top = sec.getBoundingClientRect().top;
      if (top - offset <= 0) current = sec.id;
    });
    if (!current && sections.length) current = sections[0].id;

    const activeSide = document.querySelector('.sidebar-section.active');
    if (!activeSide || !current) return;
    activeSide.querySelectorAll('a').forEach(a => {
      a.classList.toggle('active', a.getAttribute('href') === '#' + current);
    });
  }
  window.addEventListener('scroll', () => {
    if (!spyRaf) spyRaf = requestAnimationFrame(updateSpy);
  }, { passive: true });

  // ---------- Smooth sidebar click ----------
  document.querySelectorAll('.sidebar a').forEach(a => {
    a.addEventListener('click', (e) => {
      const href = a.getAttribute('href');
      if (!href || !href.startsWith('#')) return;
      const target = document.getElementById(href.slice(1));
      if (!target) return;
      e.preventDefault();
      const y = target.getBoundingClientRect().top + window.scrollY - 130;
      window.scrollTo({ top: y, behavior: 'smooth' });
    });
  });

  // initial spy run
  setTimeout(updateSpy, 100);
})();
</script>

